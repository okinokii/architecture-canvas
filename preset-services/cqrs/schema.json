{
  "version": 1,
  "zones": [
    "COMMAND SIDE",
    "EVENT BUS",
    "QUERY SIDE"
  ],
  "nodes": [
    {
      "id": "client",
      "label": "Client",
      "type": "client",
      "description": "HTTP",
      "zone": "COMMAND SIDE",
      "source": "preset:cqrs"
    },
    {
      "id": "cmdapi",
      "label": "Command API",
      "type": "gateway",
      "description": "POST /commands",
      "zone": "COMMAND SIDE",
      "source": "preset:cqrs"
    },
    {
      "id": "handler",
      "label": "Command Handler",
      "type": "service",
      "description": "агрегат, валидация",
      "zone": "COMMAND SIDE",
      "source": "preset:cqrs"
    },
    {
      "id": "eventstore",
      "label": "Event Store",
      "type": "db",
      "description": "append-only",
      "zone": "COMMAND SIDE",
      "source": "preset:cqrs"
    },
    {
      "id": "bus",
      "label": "Event Bus",
      "type": "queue",
      "description": "RabbitMQ / Kafka",
      "zone": "EVENT BUS",
      "source": "preset:cqrs"
    },
    {
      "id": "projector",
      "label": "Projector",
      "type": "service",
      "description": "применяет события",
