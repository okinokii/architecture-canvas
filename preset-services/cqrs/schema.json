    {
      "from": "projector",
      "fromLabel": "Projector",
      "to": "readdb",
      "toLabel": "Read Model DB",
      "label": "upsert",
      "async": false
    },
    {
      "from": "client",
      "fromLabel": "Client",
      "to": "queryapi",
      "toLabel": "Query API",
      "label": "запрос",
      "async": false
    },
    {
      "from": "queryapi",
      "fromLabel": "Query API",
      "to": "readdb",
      "toLabel": "Read Model DB",
      "label": "SELECT",
      "async": false
    }
  ],
  "notes": [
    "Read model может отставать — это нормально (eventual consistency).",
    "Источник истины — Event Store, а не Read Model."
  ]
