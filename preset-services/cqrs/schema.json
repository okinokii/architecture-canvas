  "edges": [
    {
      "from": "client",
      "fromLabel": "Client",
      "to": "cmdapi",
      "toLabel": "Command API",
      "label": "команда",
      "async": false
    },
    {
      "from": "cmdapi",
      "fromLabel": "Command API",
      "to": "handler",
      "toLabel": "Command Handler",
      "label": "handle",
      "async": false
    },
    {
      "from": "handler",
      "fromLabel": "Command Handler",
      "to": "eventstore",
      "toLabel": "Event Store",
      "label": "append events",
      "async": false
    },
    {
      "from": "handler",
      "fromLabel": "Command Handler",
      "to": "bus",
      "toLabel": "Event Bus",
      "label": "publish",
      "async": true
    },
    {
      "from": "bus",
      "fromLabel": "Event Bus",
      "to": "projector",
